{
  "name": "writer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "iw",
  "sourceRoot": "apps/writer/src",
  "tags": ["scope:indie-writer", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "desktop",
      "options": {
        "outputPath": { "base": "dist/apps/writer", "browser": "" },
        "browser": "apps/writer/src/main.ts",
        "index": "apps/writer/src/index.html",
        "tsConfig": "apps/writer/tsconfig.app.json",
        "baseHref": "./",
        "styles": [
          { "input": "apps/writer/src/styles.css", "bundleName": "styles", "inject": false },
          {
            "input": "apps/writer/src/dark.css",
            "bundleName": "syncfusion-dark",
            "inject": false
          }
        ]
      },
      "configurations": {
        "desktop": {
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": false },
            "fonts": false
          },
          "outputHashing": "none",
          "sourceMap": false,
          "extractLicenses": false
        },
        "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
      },
      "dependsOn": ["theme", "license"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"],
        "cwd": "apps/writer",
        "parallel": true
      },
      "dependsOn": ["theme", "license"]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "command": "vitest run", "cwd": "apps/writer" }
    },
    "theme": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/prepare-theme.ts",
        {
          "externalDependencies": [
            "@syncfusion/ej2-material-theme",
            "@syncfusion/ej2-material-dark-theme"
          ]
        }
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "node apps/writer/scripts/prepare-theme.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "license": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "node apps/writer/scripts/prepare-license.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
