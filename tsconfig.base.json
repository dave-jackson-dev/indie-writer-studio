{
  "compilerOptions": {
    "importHelpers": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@indie-writer-studio/cqrs-tool-runtime": [
        "./libs/shared/cqrs-tool-runtime/src/index.ts"
      ],
      "@indie-writer-studio/works-domain": [
        "./libs/works/domain/src/index.ts"
      ],
      "@indie-writer-studio/works-application": [
        "./libs/works/application/src/index.ts"
      ],
      "@indie-writer-studio/works-infrastructure": [
        "./libs/works/infrastructure/src/index.ts"
      ]
    },
    "experimentalDecorators": true,
    "rootDir": ".",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true
  }
}
