{
  "name": "indie-writer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/indie-writer/src",
  "projectType": "application",
  "tags": ["scope:indie-writer", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"],
      "outputs": ["{workspaceRoot}/dist/apps/indie-writer"],
      "options": {
        "command": "esbuild apps/indie-writer/src/main.ts --bundle --platform=node --target=node24 --format=esm --sourcemap --tsconfig=apps/indie-writer/tsconfig.app.json --outfile=dist/apps/indie-writer/main.js --external:@nestjs/* --external:rxjs --external:reflect-metadata --external:class-transformer --external:class-validator --external:express --external:cors",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "command": "vitest run", "cwd": "apps/indie-writer" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"],
        "cwd": "apps/indie-writer",
        "parallel": true
      }
    }
  }
}
