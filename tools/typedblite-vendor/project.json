{
  "name": "typedblite-vendor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/typedblite-vendor/src",
  "projectType": "library",
  "tags": ["scope:tooling", "type:util"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run",
        "cwd": "tools/typedblite-vendor"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": ["tsc -p tsconfig.lib.json --noEmit", "tsc -p tsconfig.spec.json --noEmit"],
        "cwd": "tools/typedblite-vendor",
        "parallel": true
      }
    }
  }
}
