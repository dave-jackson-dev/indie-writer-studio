#!/usr/bin/env node
/**
 * Refuses a commit made while HEAD is on a protected branch (`main`, `dev`).
 *
 * Protected branches change only by merged pull request. This catches the common accident — finishing
 * a merge, staying on `dev`, and typing `git commit` — not deliberate bypass: `--no-verify` defeats
 * it. It imports nothing that must be built, so it keeps working after `rm -rf dist`.
 */
import { execFileSync } from 'node:child_process';

const PROTECTED = new Set(['main', 'dev']);

let branch = null;
try {
  branch = execFileSync('git', ['symbolic-ref', '--quiet', '--short', 'HEAD'], {
    encoding: 'utf8',
  }).trim();
} catch {
  // detached HEAD: rebase, bisect, raw checkout
}

if (branch !== null && PROTECTED.has(branch)) {
  console.error(`\nCommitting on '${branch}' is blocked: protected branch.`);
  console.error('Cut a branch from dev and open a pull request:  git switch -c <type>/<slug>\n');
  process.exit(1);
}
