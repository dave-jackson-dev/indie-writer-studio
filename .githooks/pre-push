#!/usr/bin/env node
/**
 * Refuses a push whose destination is a protected branch: protected branches move only when GitHub
 * merges a pull request into them, which never goes through this hook.
 *
 * git passes one line per ref on stdin:  <local-ref> <local-sha> <remote-ref> <remote-sha>
 */
import { readFileSync } from 'node:fs';

const PROTECTED = new Set(['main', 'dev']);

let input = '';
try {
  input = readFileSync(0, 'utf8');
} catch {
  // nothing piped: nothing to judge
}

const blocked = new Set();
for (const line of input.split('\n')) {
  const remoteRef = line.trim().split(/\s+/)[2];
  if (!remoteRef?.startsWith('refs/heads/')) continue;
  const branch = remoteRef.slice('refs/heads/'.length);
  if (PROTECTED.has(branch)) blocked.add(branch);
}

if (blocked.size > 0) {
  const names = [...blocked].map((b) => `'${b}'`).join(', ');
  console.error(`\nPushing to ${names} is blocked: protected branch(es).`);
  console.error('Protected branches are only updated by merging a pull request into them.\n');
  console.error('This local hook can be bypassed with --no-verify; server-side branch protection is');
  console.error('the authoritative control.\n');
  process.exit(1);
}
