{
  "name": "@indie-writer-studio/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "indie-writer": "nx build indie-writer 1>&2 && node dist/apps/indie-writer/main.js",
    "acceptance": "TSX_TSCONFIG_PATH=tsconfig.base.json NODE_OPTIONS=--import=tsx cucumber-js --config cucumber.yaml",
    "acceptance:transports": "nx build indie-writer 1>&2 && for t in repl sidecar http; do IWS_ASSEMBLY=$t npm run acceptance || exit 1; done && npm run acceptance:cli",
    "vendor:bundle": "tsx tools/typedblite-vendor/src/cli.ts bundle",
    "vendor:check": "tsx tools/typedblite-vendor/src/cli.ts verify",
    "acceptance:cli": "IWS_ASSEMBLY=cli TSX_TSCONFIG_PATH=tsconfig.base.json NODE_OPTIONS=--import=tsx cucumber-js --config cucumber.yaml --profile cli"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@cucumber/screenplay": "^10.0.0",
    "@nx/js": "24.0.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "apps/*",
    "libs/*/*",
    "tools/*"
  ],
  "type": "module"
}
